{
    "$schema": "./node_modules/fallow/schema.json",
    // Declared here because no built-in plugin claims them: oxfmt and knip
    // have none, the validation script is a CLI entry point, and the
    // branch-name config is loaded by the husky hook.
    "entry": [
        "oxfmt.config.ts",
        "knip.config.ts",
        "scripts/validate-marketplace.ts",
        "validate-branch-name.config.cjs",
        "plugins/*/scripts/**/*.ts",
        // A plugin's hooks module: loaded by Claude Code from hooks.json `modules`.
        "plugins/*/mod/register.ts",
        // A plugin's PostToolUse command hook: run by Claude Code from hooks.json (stonks design D5).
        "plugins/*/src/capture.ts",
        // Spike stub run by hand to show the fictional report in the pane; removed in stonks task 10.1.
        "plugins/stonks/src/spike-stub.ts",
        // Loaded by the GitHub Pages HTML documents, not a JavaScript import.
        "docs/styles.css",
    ],
    // Agent scaffolding, not source. Mirrored in 4 sibling configs; see CLAUDE.md.
    "ignorePatterns": [
        "openspec/**",
        ".agents/**",
        ".claude/**",
        ".junie/**",
        ".opencode/**",
        ".pi/**",
        "coverage/**",
        // Vendored Claude Code mod API declarations (stonks design D17).
        "plugins/stonks/mod/types/claude-code.d.ts",
    ],
    // `claude-code` is the engine's own module a hooks module imports types from (stonks design D17).
    "ignoreDependencies": ["@types/bun", "validate-branch-name", "claude-code"],
    // Deliberate copies of `autonomous`'s validation primitives and configuration loader:
    // plugins install independently, so nothing is imported across them (stonks task 4.1).
    "duplicates": {
        "ignore": ["plugins/stonks/src/validate.ts", "plugins/stonks/src/config.ts"],
    },
    "rules": {
        // suppression comments must carry a reason
        "require-suppression-reason": "warn",
    },
}
