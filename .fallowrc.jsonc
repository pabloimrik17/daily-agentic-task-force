{
    "$schema": "./node_modules/fallow/schema.json",
    // Written from scratch rather than ported: monolab lists its plugin
    // directory in ignorePatterns, so its config has never analysed plugin
    // code. Here, plugins are the codebase.
    //
    // eslint, vitest, commitlint and lint-staged configs are picked up by
    // built-in plugins; oxfmt and knip have none, and the validation script is
    // a CLI entry point rather than an import target, so they are declared here
    // alongside the branch-name config, which the husky hook loads by convention.
    "entry": [
        "oxfmt.config.ts",
        "knip.config.ts",
        "scripts/validate-marketplace.ts",
        "validate-branch-name.config.cjs",
        "plugins/*/scripts/**/*.ts",
    ],
    // Agent scaffolding — tooling for AI hosts, not this repository's source.
    // Keep this list identical to .oxfmtignore, eslint.config.ts,
    // knip.config.ts and .markdownlintignore; divergence shows up as one tool
    // failing on files the others skip.
    "ignorePatterns": [
        "openspec/**",
        ".agents/**",
        ".claude/**",
        ".junie/**",
        ".opencode/**",
        ".pi/**",
        "coverage/**",
    ],
    "ignoreDependencies": ["@types/bun", "validate-branch-name"],
    "rules": {
        // suppression comments must carry a reason
        "require-suppression-reason": "warn",
    },
}
