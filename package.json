{
    "name": "daily-agentic-task-force",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "plugins/*"
    ],
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:fallow": "fallow dead-code --fail-on-issues",
        "lint:knip": "knip --max-issues 40",
        "lint:knip:fix": "knip --fix",
        "lint:markdown": "markdownlint .",
        "lint:markdown:fix": "markdownlint --fix .",
        "lint:marketplace": "bun run scripts/validate-marketplace.ts",
        "lint:oxfmt": "oxfmt --check --ignore-path .oxfmtignore",
        "lint:oxfmt:fix": "oxfmt --ignore-path .oxfmtignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@commitlint/types": "21.2.0",
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.7.0",
        "eslint-plugin-regexp": "3.1.1",
        "fallow": "3.6.0",
        "globals": "17.7.0",
        "husky": "9.1.7",
        "knip": "6.27.0",
        "lint-staged": "17.1.0",
        "markdownlint-cli": "0.49.1",
        "oxfmt": "0.59.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0",
        "validate-branch-name": "1.3.2",
        "vitest": "4.1.10"
    },
    "packageManager": "bun@1.4.2"
}
