{
    "name": "daily-agentic-task-force",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "plugins/*"
    ],
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:fallow": "fallow dead-code --fail-on-issues",
        "lint:knip": "knip --max-issues 40",
        "lint:knip:fix": "knip --fix",
        "lint:markdown": "markdownlint .",
        "lint:markdown:fix": "markdownlint --fix .",
        "lint:marketplace": "bun run scripts/validate-marketplace.ts",
        "lint:oxfmt": "oxfmt --check",
        "lint:oxfmt:fix": "oxfmt",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && bun run --filter './plugins/*' typecheck"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.7.0",
        "eslint-plugin-regexp": "3.1.1",
        "eslint-plugin-tsdoc": "0.5.4",
        "eslint-plugin-yml": "3.9.0",
        "fallow": "3.34.0",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "knip": "6.27.0",
        "lint-staged": "17.6.0",
        "markdownlint-cli": "0.49.1",
        "oxfmt": "0.59.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "validate-branch-name": "1.3.2",
        "vitest": "5.0.5"
    },
    "overrides": {
        "katex": "0.18.2",
        "markdownlint-cli": {
            "js-yaml": "5.4.1"
        },
        "smol-toml": "1.9.0",
        "tinypool": "2.1.2"
    },
    "packageManager": "bun@1.4.2"
}
