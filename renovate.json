{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":maintainLockFilesWeekly",
        "security:openssf-scorecard",
        "customManagers:githubActionsVersions"
    ],
    "timezone": "Europe/Madrid",
    "reviewers": ["pabloimrik17"],
    "labels": ["dependencies"],
    "baseBranchPatterns": ["main"],
    "dependencyDashboardTitle": "📦 Dependency Dashboard",
    "prConcurrentLimit": 10,
    "prHourlyLimit": 2,
    "minimumReleaseAge": "14 days",
    "rangeStrategy": "pin",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "prHourlyLimit": 0,
        "prConcurrentLimit": 0
    },
    "packageRules": [
        {
            "matchUpdateTypes": ["patch"],
            "schedule": ["on the first day of the month"]
        },
        {
            "matchUpdateTypes": ["minor"],
            "schedule": ["on the first day of the month every 2 months"]
        },
        {
            "matchUpdateTypes": ["major"],
            "schedule": ["on the first day of the month every 3 months"]
        },
        {
            "description": "security:minimumReleaseAgeNpm (via config:best-practices) sets npm to 3 days; restore 14 for majors and minors",
            "matchDatasources": ["npm"],
            "matchUpdateTypes": ["major", "minor"],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Patches wait 3 days, never below Bun's minimumReleaseAge (bunfig.toml)",
            "matchUpdateTypes": ["patch"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "One PR for every Bun pin",
            "matchPackageNames": ["bun", "oven/bun", "@types/bun"],
            "groupName": "bun"
        },
        {
            "description": "Update the fallow CLI and its GitHub Action together",
            "matchPackageNames": ["fallow", "fallow-rs/fallow"],
            "groupName": "fallow"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update pinned CLI tool versions in CI workflows (bunx/npx)",
            "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
            "matchStrings": [
                "(?:bunx|npx) (?<depName>(?:@[^/\\s]+/)?[^@\\s]+)@(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update pinned 'bunx --package <pkg>@<ver>' versions (renovate-config-validator and similar)",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/",
                "/^lint-staged\\.config\\.ts$/"
            ],
            "matchStrings": [
                "bunx (?:--package|-p) (?<depName>(?:@[^/\\s]+/)?[^@\\s]+)@(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "npm"
        }
    ]
}
