{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":maintainLockFilesWeekly",
        "security:openssf-scorecard",
        "customManagers:githubActionsVersions"
    ],
    "timezone": "Europe/Madrid",
    "reviewers": ["pabloimrik17"],
    "labels": ["dependencies"],
    "baseBranchPatterns": ["main"],
    "dependencyDashboardTitle": "📦 Dependency Dashboard",
    "prConcurrentLimit": 10,
    "prHourlyLimit": 2,
    "minimumReleaseAge": "14 days",
    "rangeStrategy": "pin",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "prHourlyLimit": 0,
        "prConcurrentLimit": 0
    },
    "packageRules": [
        {
            "matchUpdateTypes": ["patch"],
            "schedule": ["on the first day of the month"]
        },
        {
            "matchUpdateTypes": ["minor"],
            "schedule": ["on the first day of the month every 2 months"]
        },
        {
            "matchUpdateTypes": ["major"],
            "schedule": ["on the first day of the month every 3 months"]
        },
        {
            "description": "security:minimumReleaseAgeNpm (via config:best-practices) sets npm to 3 days; restore 14 for majors and minors",
            "matchDatasources": ["npm"],
            "matchUpdateTypes": ["major", "minor"],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Patches wait 3 days, never below Bun's minimumReleaseAge (bunfig.toml)",
            "matchUpdateTypes": ["patch"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "One PR for every Bun pin",
            "matchPackageNames": ["bun", "oven/bun", "@types/bun"],
            "groupName": "bun"
        },
        {
            "description": "Update the fallow CLI and its GitHub Action together",
            "matchPackageNames": ["fallow", "fallow-rs/fallow"],
            "groupName": "fallow"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pinned bunx packages in executable commands and tool launchers",
            "managerFilePatterns": [
                "/(^|/)package\\.json$/",
                "/(^|/)(?:\\.github/workflows|\\.github/actions|\\.eas/workflows)/.*\\.ya?ml$/",
                "/(^|/)(?:bitbucket-pipelines|\\.gitlab-ci|azure-pipelines)\\.ya?ml$/",
                "/\\.(?:sh|bash|zsh)$/",
                "/(^|/)\\.husky/[^/]+$/",
                "/(^|/)(?:Dockerfile(?:\\.[^/]+)?|[^/]+\\.Dockerfile|[Mm]akefile|[Jj]ustfile)$/",
                "/(^|/)(?:\\.?lint-?staged(?:\\.config)?\\.(?:[cm]?[jt]s|json)|\\.lintstagedrc(?:\\.(?:[cm]?[jt]s|json|ya?ml))?)$/",
                "/(^|/)(?:\\.mcp|opencode)\\.json$/",
                "/(^|/)\\.(?:gemini|codex|claude|cursor)/.*\\.(?:jsonc?|toml|ya?ml|[cm]?[jt]s)$/",
                "/(^|/)\\.junie/mcp/mcp\\.json$/"
            ],
            "matchStrings": [
                "(?:^|[\\s\"\\x27`=;|&(])bunx\\s+(?:--minimum-release-age(?:\\s+|=)1d\\s+)?(?:--bun\\s+)?(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])",
                "\\bcommand[\"\\x27]?\\s*[:=]\\s*\"bunx\"\\s*,?\\s*[\"\\x27]?args[\"\\x27]?\\s*[:=]\\s*\\[\\s*(?:\"--minimum-release-age\"\\s*,\\s*\"1d\"\\s*,\\s*)?(?:\"--bun\"\\s*,\\s*)?(?:\"(?:--package|-p)\"\\s*,\\s*)?\"(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\"",
                "\\bcommand[\"\\x27]?\\s*[:=]\\s*\\[\\s*\"bunx\"\\s*,\\s*(?:\"--minimum-release-age\"\\s*,\\s*\"1d\"\\s*,\\s*)?(?:\"--bun\"\\s*,\\s*)?(?:\"(?:--package|-p)\"\\s*,\\s*)?\"(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\""
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        }
    ]
}
