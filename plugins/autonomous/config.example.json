{
    "schema": "autonomous.config.v1",
    "sources": {
        "linear": {
            "enabled": true,
            "scope": "personal",
            "aliases": { "grill-me": ["Grill Me"] }
        },
        "beads": {
            "enabled": true,
            "directory": "/path/to/beads/repo",
            "aliases": {
                "work": ["project:example"],
                "personal": ["project:personal"],
                "HITL": ["human"]
            }
        },
        "github": {
            "enabled": true,
            "repos": ["owner/repo"],
            "scope": "personal"
        }
    },
    "judgement": {
        "model": "claude-sonnet-5",
        "effort": "medium",
        "threshold": 0.95,
        "cap": 25,
        "batch": 20
    },
    "selection": {
        "model": "sonnet",
        "effort": "high"
    },
    "sessions": {
        "tool": "claude",
        "profile": null,
        "binary": null
    },
    "workspace": {
        "root": "~/WebstormProjects"
    },
    "naming": {
        "model": "haiku",
        "effort": "low"
    },
    "runner": {
        "grills": 1,
        "parallel": 2,
        "intervalMinutes": 10
    },
    "review": {
        "tiers": {
            "S": { "maxLines": 150, "maxFiles": 5 },
            "M": { "maxLines": 600, "maxFiles": 20 }
        },
        "team": {
            "S": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "medium", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "medium" }
            ],
            "M": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "high", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "medium" },
                { "reviewer": "coderabbit" }
            ],
            "L": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "xhigh", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "high" },
                { "reviewer": "coderabbit" },
                { "reviewer": "tests-lens", "model": "opus", "effort": "high" }
            ]
        },
        "security": {
            "model": "opus",
            "effort": "high",
            "pathPatterns": ["auth", "secret", "(^|/)\\.env(\\.|$)"],
            "linePatterns": ["\\b(execFile|spawn)\\s*\\(", "\\beval\\s*\\("]
        },
        "external": {
            "waitMinutes": 30,
            "answerWaitMinutes": 10,
            "rounds": 3,
            "bots": [
                {
                    "id": "coderabbit",
                    "login": "coderabbitai[bot]",
                    "check": "CodeRabbit",
                    "mention": null
                },
                {
                    "id": "greptile",
                    "login": "greptile-apps[bot]",
                    "check": "Greptile Review",
                    "mention": null
                },
                { "id": "pullfrog", "login": "pullfrog[bot]", "check": "pullfrog", "mention": null }
            ]
        }
    }
}
