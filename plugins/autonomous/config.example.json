{
    "schema": "autonomous.config.v1",
    "sources": {
        "linear": {
            "enabled": true,
            "scope": "personal",
            "aliases": { "grill-me": ["Grill Me"] }
        },
        "beads": {
            "enabled": true,
            "directory": "/path/to/beads/repo",
            "aliases": {
                "work": ["project:example"],
                "personal": ["project:personal"],
                "HITL": ["human"]
            }
        },
        "github": {
            "enabled": true,
            "repos": ["owner/repo"],
            "scope": "personal"
        }
    },
    "judgement": {
        "model": "claude-sonnet-5",
        "effort": "medium",
        "threshold": 0.95,
        "cap": 25,
        "batch": 20
    },
    "selection": {
        "model": "sonnet",
        "effort": "high"
    },
    "sessions": {
        "tool": "claude",
        "profile": null,
        "binary": null
    },
    "workspace": {
        "root": "~/WebstormProjects"
    },
    "naming": {
        "model": "haiku",
        "effort": "low"
    },
    "runner": {
        "grills": 1,
        "parallel": 2,
        "intervalMinutes": 10
    },
    "review": {
        "tiers": {
            "S": { "maxLines": 150, "maxFiles": 5 },
            "M": { "maxLines": 600, "maxFiles": 20 }
        },
        "team": {
            "S": [
                { "reviewer": "walkthrough" },
                { "reviewer": "code-review", "level": "medium" },
                { "reviewer": "codex", "effort": "medium" }
            ],
            "M": [
                { "reviewer": "walkthrough" },
                { "reviewer": "code-review", "level": "high" },
                { "reviewer": "codex", "effort": "medium" },
                { "reviewer": "coderabbit" },
                { "reviewer": "fallow-review" }
            ],
            "L": [
                { "reviewer": "walkthrough" },
                { "reviewer": "code-review", "level": "xhigh" },
                { "reviewer": "codex", "effort": "high" },
                { "reviewer": "coderabbit" },
                { "reviewer": "fallow-review" },
                { "reviewer": "tests-lens" }
            ]
        },
        "security": {
            "pathPatterns": ["auth", "secret", "(^|/)\\.env(\\.|$)"],
            "linePatterns": ["\\b(execFile|spawn)\\s*\\(", "\\beval\\s*\\("]
        }
    }
}
