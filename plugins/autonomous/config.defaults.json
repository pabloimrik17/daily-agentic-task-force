{
    "sessions": { "tool": "claude", "profile": null, "binary": null },
    "workspace": { "root": "~/WebstormProjects" },
    "naming": { "model": "haiku", "effort": "low" },
    "runner": { "grills": 1, "parallel": 2, "intervalMinutes": 10 },
    "review": {
        "tiers": {
            "S": { "maxLines": 150, "maxFiles": 5 },
            "M": { "maxLines": 600, "maxFiles": 20 }
        },
        "team": {
            "S": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "medium", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "medium" }
            ],
            "M": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "high", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "medium" },
                { "reviewer": "coderabbit" }
            ],
            "L": [
                { "reviewer": "walkthrough", "model": "opus", "effort": "medium" },
                { "reviewer": "code-review", "level": "xhigh", "model": "opus", "effort": "high" },
                { "reviewer": "codex", "effort": "high" },
                { "reviewer": "coderabbit" },
                { "reviewer": "tests-lens", "model": "opus", "effort": "high" }
            ]
        },
        "security": {
            "model": "opus",
            "effort": "high",
            "pathPatterns": [
                "auth",
                "token",
                "secret",
                "credential",
                "crypto",
                "permission",
                "(^|/)\\.env(\\.|$)"
            ],
            "linePatterns": [
                "\\b(exec|execFile|execSync|execFileSync|spawn|spawnSync)\\s*\\(",
                "\\bBun\\.spawn(Sync)?\\s*\\(",
                "\\beval\\s*\\(",
                "\\bnew\\s+Function\\s*\\(",
                "\\b(readFile|writeFile|readdir|createReadStream|createWriteStream)\\w*\\s*\\([^)]*\\b(req|request|params|query|body|userInput)\\b"
            ]
        },
        "external": {
            "waitMinutes": 30,
            "answerWaitMinutes": 10,
            "rounds": 3,
            "bots": [
                {
                    "id": "coderabbit",
                    "login": "coderabbitai[bot]",
                    "check": "CodeRabbit",
                    "mention": null
                },
                {
                    "id": "greptile",
                    "login": "greptile-apps[bot]",
                    "check": "Greptile Review",
                    "mention": null
                },
                { "id": "pullfrog", "login": "pullfrog[bot]", "check": "pullfrog", "mention": null }
            ]
        }
    }
}
