# Detached HEAD (e.g. amending in a rebase) has no branch name to validate; CI checks PR branch names.
if git symbolic-ref -q HEAD >/dev/null; then
    bun run validate-branch-name
fi
# If this hook is killed, restore hidden work from the "lint-staged automatic backup" stash with git stash apply.
bun run lint-staged --hide-all --config lint-staged.config.ts
mise x -- gitleaks git --pre-commit --staged --redact -v --no-banner
